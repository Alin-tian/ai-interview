# ============================================
# docker中安装的mysql、es、redis、
# ============================================

DATABASE_URL=mysql+aiomysql://interview:123456_mysql@localhost:3307/interview_agent?charset=utf8mb4
APP_DEBUG=false
ES_HOST=http://localhost:9200
REDIS_URL=redis://localhost:6379/0

UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:3000
# ============================================
# openai/gpt-4o-mini
# ============================================
LLM_API_KEY=sk-or-v1-replace_me
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
# 单次模型结构化输出的最大等待时间；超时后回答评估会降级为规则评估。
LLM_REQUEST_TIMEOUT_SECONDS=45

# Tavily 联网搜索：未配置时只使用用户提供的公开 URL，不会伪造搜索结果。
TAVILY_API_KEY=tvly-replace_me

EMBEDDING_API_KEY=sk-or-v1-replace_me
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small
